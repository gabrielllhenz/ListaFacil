<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_red">

    <!-- Header Fixo -->
    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Barra superior -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/accent_gold"
                android:contentDescription="Voltar" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="HISTÓRICO"
                android:textSize="24sp"
                android:textColor="@color/accent_gold"
                android:fontFamily="sans-serif-medium" />

            <ImageView
                android:id="@+id/ivCart"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_cart"
                app:tint="@color/accent_gold"
                android:contentDescription="Carrinho" />
        </LinearLayout>

        <!-- Seletor de Mês/Ano -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp">

            <ImageView
                android:id="@+id/ivPrevMonth"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/accent_gold"
                android:contentDescription="Mês anterior" />

            <TextView
                android:id="@+id/tvMonthYear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Novembro 2025"
                android:textSize="18sp"
                android:textColor="@color/text_white"
                android:fontFamily="sans-serif-medium"
                android:gravity="center" />

            <ImageView
                android:id="@+id/ivNextMonth"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/accent_gold"
                android:contentDescription="Próximo mês" />
        </LinearLayout>

    </LinearLayout>

    <!-- ViewPager2 para carrossel -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpHistorico"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/llHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Mensagem quando não há histórico -->
    <TextView
        android:id="@+id/tvNoHistory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nenhuma compra neste período"
        android:textSize="16sp"
        android:textColor="@color/text_white"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/vpHistorico"
        app:layout_constraintBottom_toBottomOf="@id/vpHistorico"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
